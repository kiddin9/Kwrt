From caa2aae3d150d293c200ce23373d248a89dd7807 Mon Sep 17 00:00:00 2001
From: Chukun Pan <amadeus@jmu.edu.cn>
Date: Tue, 8 Sep 2026 18:16:01 +0800
Subject: [PATCH 1/2] mediatek: add Cudy TR3600 v1 support

Hardware specification:
  SoC: MediaTek MT7987B 2x A53
  Flash: ESMT F50L2G41XA 256MB
  RAM: M16U4G16256A DDR4 512MB
  Ethernet: 2x 2.5G LAN / WAN
  WiFi: MT7990AN + MT7976CN
  LED: Status (red / white)
  Button: Reset, Mode
  USB: 1x USB-A 3.0
  Power: PD / 5V 3A

MAC addresses map:
   LAN D4:xx:xx:xx:xx:C1
   WAN D4:xx:xx:xx:xx:C2
   2G  D4:xx:xx:xx:xx:C1
   5G  D4:xx:xx:xx:xx:C3

Flash instructions:
  1. Update the intermediate firmware [1] on the upgrade page.
  2. Upload sysupgrade.bin to perform the upgrade.

[1] https://www.cudy.com/cdn/shop/files/Develop_files_for_TR3600.zip

Signed-off-by: Chukun Pan <amadeus@jmu.edu.cn>
---
 .../uboot-envtools/files/mediatek_filogic     |  13 +-
 .../lib/preinit/05_set_preinit_iface          |   1 +
 .../mediatek/dts/mt7987b-cudy-tr3600-v1.dts   | 237 ++++++++++++++++++
 .../filogic/base-files/etc/board.d/02_network |   1 +
 target/linux/mediatek/image/filogic.mk        |  19 ++
 5 files changed, 265 insertions(+), 6 deletions(-)
 create mode 100644 target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts

diff --git a/package/boot/uboot-tools/uboot-envtools/files/mediatek_filogic b/package/boot/uboot-tools/uboot-envtools/files/mediatek_filogic
index 5fe5752ebab365..d19289d1aed942 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/mediatek_filogic
+++ b/package/boot/uboot-tools/uboot-envtools/files/mediatek_filogic
@@ -141,6 +141,13 @@ comfast,cf-e393ax|\
 iptime,ax3000m)
 	ubootenv_add_uci_config "/dev/mtd1" "0x0" "0x20000" "0x80000"
 	;;
+cudy,tr3600-v1|\
+ltc,vl7m19k)
+	. /lib/upgrade/nand.sh
+	envubi=$(nand_find_ubi ubi)
+	envdev=/dev/$(nand_find_volume "$envubi" u-boot-env)
+	ubootenv_add_uci_config "$envdev" "0x0" "0x80000" "0x80000" "1"
+	;;
 dlink,aquila-pro-ai-e30-a1|\
 dlink,aquila-pro-ai-m30-a1|\
 dlink,aquila-pro-ai-m60-a1)
@@ -159,12 +166,6 @@ jiorouter,ax6000-jidu6j01)
 	envdev=/dev/$(nand_find_volume "$envubi" u-boot-env)
 	ubootenv_add_uci_config "$envdev" "0x0" "0x80000" "0x1f000" "5"
 	;;
-ltc,vl7m19k)
-	. /lib/upgrade/nand.sh
-	envubi=$(nand_find_ubi ubi)
-	envdev=/dev/$(nand_find_volume "$envubi" u-boot-env)
-	ubootenv_add_uci_config "$envdev" "0x0" "0x80000" "0x80000" "1"
-	;;
 openembed,som7981)
 	ubootenv_add_uci_config "/dev/mtd1" "0x0" "0x80000" "0x80000"
 	ubootenv_add_uci_sys_config "/dev/mtd3" "0x0" "0x100000" "0x100000"
diff --git a/target/linux/mediatek/base-files/lib/preinit/05_set_preinit_iface b/target/linux/mediatek/base-files/lib/preinit/05_set_preinit_iface
index 007fb5463f23c7..40618963b9a1f3 100644
--- a/target/linux/mediatek/base-files/lib/preinit/05_set_preinit_iface
+++ b/target/linux/mediatek/base-files/lib/preinit/05_set_preinit_iface
@@ -6,6 +6,7 @@ set_preinit_iface() {
 	cudy,tr3000-256mb-v1|\
 	cudy,tr3000-v1|\
 	cudy,tr3000-mod|\
+	cudy,tr3600-v1|\
 	glinet,gl-mt2500|\
 	glinet,gl-mt2500-airoha|\
 	glinet,gl-mt3000|\
diff --git a/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
new file mode 100644
index 00000000000000..d47e58414f631a
--- /dev/null
+++ b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+
+/dts-v1/;
+#include "mt7987b.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Cudy TR3600 v1";
+	compatible = "cudy,tr3600-v1", "mediatek,mt7987";
+
+	aliases {
+		led-boot = &led_sys_red;
+		led-failsafe = &led_sys_red;
+		led-running = &led_sys_white;
+		led-upgrade = &led_sys_white;
+		label-mac-device = &gmac1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		mode {
+			label = "mode";
+			linux,code = <BTN_0>;
+			linux,input-type = <EV_SW>;
+			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_sys_red: led-0 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&pio 46 GPIO_ACTIVE_LOW>;
+		};
+
+		led_sys_white: led-1 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_WHITE>;
+			gpios = <&pio 48 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&fan {
+	pwms = <&pwm 0 50000 0>;
+	cooling-levels = <0 64 128 192 255>;
+	status = "okay";
+};
+
+&gmac0 {
+	nvmem-cell-names = "mac-address";
+	nvmem-cells = <&macaddr_bdinfo_de00 1>;
+
+	phy-mode = "2500base-x";
+	phy-handle = <&phy1>;
+	status = "okay";
+};
+
+&gmac1 {
+	nvmem-cell-names = "mac-address";
+	nvmem-cells = <&macaddr_bdinfo_de00 0>;
+
+	phy-mode = "internal";
+	phy-handle = <&phy15>;
+	status = "okay";
+};
+
+&mdio {
+	phy1: phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <1>;
+		reset-assert-us = <100000>;
+		reset-deassert-us = <100000>;
+		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
+		interrupts = <41 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-parent = <&pio>;
+	};
+
+	phy15: phy@15 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <15>;
+	};
+};
+
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_pins>;
+	status = "okay";
+
+	pcie@0,0 {
+		reg = <0x0000 0 0 0 0>;
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+
+		wifi@0,0 {
+			compatible = "mediatek,mt76";
+			reg = <0x0000 0 0 0 0>;
+
+			nvmem-cells = <&eeprom_factory_0>;
+			nvmem-cell-names = "eeprom";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			band@0 {
+				reg = <0>;
+				nvmem-cells = <&macaddr_bdinfo_de00 0>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			band@1 {
+				reg = <1>;
+				nvmem-cells = <&macaddr_bdinfo_de00 2>;
+				nvmem-cell-names = "mac-address";
+			};
+		};
+	};
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm_pins>;
+	status = "okay";
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_flash_pins>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+
+		spi-max-frequency = <52000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+
+		mediatek,nmbm;
+		mediatek,bmt-max-ratio = <1>;
+		mediatek,bmt-max-reserved-blocks = <64>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "BL2";
+				reg = <0x000000 0x0100000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "backup";
+				reg = <0x100000 0x0080000>;
+			};
+
+			partition@180000 {
+				label = "Factory";
+				reg = <0x180000 0x0400000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					eeprom_factory_0: eeprom@0 {
+						reg = <0x0 0x1e00>;
+					};
+				};
+			};
+
+			partition@580000 {
+				label = "bdinfo";
+				reg = <0x580000 0x0040000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_bdinfo_de00: macaddr@de00 {
+						compatible = "mac-base";
+						reg = <0xde00 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@5c0000 {
+				label = "FIP";
+				reg = <0x5c0000 0x0200000>;
+				read-only;
+			};
+
+			partition@7c0000 {
+				label = "ubi";
+				reg = <0x7c0000 0xe840000>;
+				compatible = "linux,ubi";
+			};
+		};
+	};
+};
+
+&ssusb {
+	status = "okay";
+};
+
+&tphyu3port0 {
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pins>;
+	status = "okay";
+};
+
+&cpu_thermal {
+	trips {
+		cpu_trip_fan_low: fan-low {
+			temperature = <65000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		cpu_trip_fan_med: fan-med {
+			temperature = <72000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		cpu_trip_fan_high: fan-high {
+			temperature = <80000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		cpu_trip_fan_max: fan-max {
+			temperature = <88000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&cpu_trip_fan_low>;
+			cooling-device = <&fan 1 1>;
+			contribution = <1024>;
+		};
+
+		map1 {
+			trip = <&cpu_trip_fan_med>;
+			cooling-device = <&fan 2 2>;
+			contribution = <1024>;
+		};
+
+		map2 {
+			trip = <&cpu_trip_fan_high>;
+			cooling-device = <&fan 3 3>;
+			contribution = <1024>;
+		};
+
+		map3 {
+			trip = <&cpu_trip_fan_max>;
+			cooling-device = <&fan 4 4>;
+			contribution = <1024>;
+		};
+	};
+};
diff --git a/target/linux/mediatek/filogic/base-files/etc/board.d/02_network b/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
index bc26dc42ae2dc2..a320c769e9a042 100644
--- a/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
+++ b/target/linux/mediatek/filogic/base-files/etc/board.d/02_network
@@ -149,6 +149,7 @@ mediatek_setup_interfaces()
 	cudy,tr3000-256mb-v1|\
 	cudy,tr3000-v1|\
 	cudy,tr3000-mod|\
+	cudy,tr3600-v1|\
 	glinet,gl-mt3600be|\
 	glinet,gl-mt2500|\
 	glinet,gl-mt2500-airoha|\
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 112b1decedcda7..49f5aac2d66cba 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -1298,6 +1298,25 @@ define Device/cudy_tr3000-mod
 endef
 TARGET_DEVICES += cudy_tr3000-mod
 
+define Device/cudy_tr3600-v1
+  DEVICE_VENDOR := Cudy
+  DEVICE_MODEL := TR3600
+  DEVICE_VARIANT := v1
+  DEVICE_DTS := mt7987b-cudy-tr3600-v1
+  DEVICE_DTS_DIR := ../dts
+  UBINIZE_OPTS := -E 5
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  KERNEL_IN_UBI := 1
+  IMAGE_SIZE := 237824k
+  SUPPORTED_DEVICES += R126
+  KERNEL_LOADADDR := 0x40000000
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+  DEVICE_PACKAGES := kmod-hwmon-pwmfan kmod-mt7990-firmware \
+	kmod-phy-mediatek-2p5g kmod-usb3 mt7987-2p5g-phy-firmware
+endef
+TARGET_DEVICES += cudy_tr3600-v1
+
 define Device/cudy_wr3000-v1
   DEVICE_VENDOR := Cudy
   DEVICE_MODEL := WR3000

From 8bfda6a6632bdf06bff4015b2f97af42e5813192 Mon Sep 17 00:00:00 2001
From: Chukun Pan <amadeus@jmu.edu.cn>
